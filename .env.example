# Root local dev env (copy to .env)
#
# Shared Sanity project settings used by both apps.
SANITY_PROJECT_ID=
SANITY_DATASET=

# Optional (defaults are handled in code/tooling as needed)
SANITY_API_VERSION=2024-01-01

# Web (Netlify): duplicate as PUBLIC_* or set in Netlify UI — see apps/web/.env.example
# PUBLIC_SANITY_PROJECT_ID=
# PUBLIC_SANITY_DATASET=
# PUBLIC_SITE_URL=https://your-site.netlify.app

