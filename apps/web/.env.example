# Web app env (Astro)
#
# PUBLIC_* values are safe to expose to the browser bundle.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=
PUBLIC_SANITY_API_VERSION=2024-01-01
PUBLIC_SITE_URL=https://your-site.netlify.app

# Server-only members auth (never prefix with PUBLIC_; do not import in client code).
# Set the same keys in Netlify: Site settings → Environment variables (production + preview as needed).
# Magic-link sign-in (after MEMBERS_MAGIC_LINK_TOKEN is set):
#   /api/members/bootstrap?t=<TOKEN>
#   /api/members/bootstrap?t=<TOKEN>&to=/en/events   (optional same-origin redirect)
# See docs/ws-j-deploy-ci-env.md § Members-only access.
MEMBERS_SESSION_SECRET= # openssl rand -hex 32
MEMBERS_PASSWORD= # Pick a strong passphrase
MEMBERS_MAGIC_LINK_TOKEN= # openssl rand -hex 24
