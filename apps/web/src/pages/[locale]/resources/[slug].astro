---
// SSR (Astro hybrid via @astrojs/netlify). See `.cursor/plans/members_area_final_implementation_plan.md`.
// Step 5 wires session-aware fetch switching and the unauthenticated-noindex stub.
export const prerender = false;

import type { SupportedLocale } from "@brtu/locales";
import ResourceDetail from "../../../components/ResourceDetail.tsx";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import RedirectShell from "../../../components/RedirectShell.astro";
import { fetchLangHrefAlternates, englishSourceId } from "../../../lib/i18n/langAlternates";
import { publishedLocales, supportedLocales, withLocalePath } from "../../../lib/i18n/locales";
import { getSanityClient } from "../../../lib/sanity/client";
import { allResourcePathRows, resourceBySlugAndLocale } from "../../../lib/sanity/queries";
import { buildTranslatableSlugPaths } from "../../../lib/i18n/staticPaths";

export async function getStaticPaths() {
  const client = getSanityClient();
  const rows = await client.fetch(allResourcePathRows);
  const paths = buildTranslatableSlugPaths(
    rows,
    publishedLocales,
    "en",
    (loc, s) => withLocalePath(loc, `resources/${s}`),
  );
  return paths.map((p) => ({ params: p.params, props: p.props }));
}

const locale = Astro.params.locale as SupportedLocale;
const slug = Astro.params.slug as string;

if (!supportedLocales.includes(locale) || !slug) {
  return new Response(null, { status: 404 });
}

const mode = Astro.props.mode as "content" | "redirect";
const redirectTo = Astro.props.redirectTo as string | undefined;
const showRedirect = mode === "redirect" && Boolean(redirectTo);

const client = getSanityClient();
const resource = showRedirect
  ? null
  : await client.fetch<{
      _id: string;
      locale: string;
      title: string;
      slug: string;
      summary: string;
      updatedAt: string;
      category: { title: string; slug: string } | null;
      file?: { asset?: { url?: string; originalFilename?: string; mimeType?: string } };
      externalUrl?: string | null;
      body?: unknown;
      translationOf?: { _id: string } | null;
    }>(resourceBySlugAndLocale, { locale, slug });

if (!showRedirect && !resource) {
  return new Response(null, { status: 404 });
}

const enId = resource ? englishSourceId(resource) : "";
const langSwitcherAlternates = resource
  ? await fetchLangHrefAlternates(
      client,
      "resource",
      enId,
      (loc, s) => withLocalePath(loc, `resources/${s}`),
      publishedLocales,
    )
  : {};
const pathAfterLocale = resource ? `resources/${resource.slug}` : `resources/${slug}`;
const fileAsset = resource?.file?.asset;
const fileUrl = fileAsset?.url ?? null;
const fileMimeType = fileAsset?.mimeType ?? null;
const fileName = fileAsset?.originalFilename ?? "download";
---

{
  showRedirect ? (
    <RedirectShell to={redirectTo!} />
  ) : (
    <BaseLayout
      title={resource!.title}
      locale={locale}
      langSwitcherAlternates={langSwitcherAlternates}
      pathAfterLocale={pathAfterLocale}
    >
      <ResourceDetail
        locale={locale}
        title={resource!.title}
        categoryTitle={resource!.category?.title}
        updatedAt={resource!.updatedAt}
        summary={resource!.summary}
        fileUrl={fileUrl}
        fileMimeType={fileMimeType}
        fileName={fileName}
        externalUrl={resource!.externalUrl}
      />
    </BaseLayout>
  )
}
