---
import type { SupportedLocale } from "@brtu/locales";
import ResourceDirectory from "../../../components/ResourceDirectory.tsx";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import type { LangHrefMap } from "../../../lib/i18n/langAlternates";
import { publishedLocales, supportedLocales, withLocalePath } from "../../../lib/i18n/locales";
import { getSanityClient } from "../../../lib/sanity/client";
import { resourcesByLocale } from "../../../lib/sanity/queries";

export async function getStaticPaths() {
  return publishedLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as SupportedLocale;
if (!supportedLocales.includes(locale)) {
  return new Response(null, { status: 404 });
}

const client = getSanityClient();
const resources = await client.fetch<
  Array<{
    title: string;
    slug: string;
    summary: string;
    updatedAt: string;
    category: { title: string; slug: string } | null;
  }>
>(resourcesByLocale, { locale });

const categoryMap = new Map<string, string>();
for (const r of resources) {
  if (r.category) categoryMap.set(r.category.slug, r.category.title);
}
const categories = [...categoryMap.entries()].sort((a, b) => a[1].localeCompare(b[1]));
const categoryList = categories.map(([slug, title]) => ({ slug, title }));

const langSwitcherAlternates = Object.fromEntries(
  publishedLocales.map((l) => [l, withLocalePath(l, "resources")]),
) as LangHrefMap;
---

<BaseLayout
  title="Resources"
  locale={locale}
  langSwitcherAlternates={langSwitcherAlternates}
  pathAfterLocale="resources"
>
  <h1>Resources</h1>

  <ResourceDirectory client:visible locale={locale} categories={categoryList} resources={resources} />
</BaseLayout>
