---
// SSR (Astro hybrid via @astrojs/netlify). See `.cursor/plans/members_area_final_implementation_plan.md`.
export const prerender = false;

import type { SupportedLocale } from "@brtu/locales";
import EventsIndex from "../../../components/EventsIndex.tsx";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import type { LangHrefMap } from "../../../lib/i18n/langAlternates";
import { publishedLocales, supportedLocales, withLocalePath } from "../../../lib/i18n/locales";
import { getMemberSession } from "../../../lib/members/session";
import { getSanityClient } from "../../../lib/sanity/client";
import {
  pastEventsByLocaleFull,
  pastEventsByLocalePublic,
  upcomingEventsByLocaleFull,
  upcomingEventsByLocalePublic,
} from "../../../lib/sanity/queries";

export async function getStaticPaths() {
  return publishedLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as SupportedLocale;
if (!supportedLocales.includes(locale)) {
  return new Response(null, { status: 404 });
}

const { authenticated } = getMemberSession(Astro.request);
const now = new Date().toISOString();
const client = getSanityClient();
const upcomingQuery = authenticated ? upcomingEventsByLocaleFull : upcomingEventsByLocalePublic;
const pastQuery = authenticated ? pastEventsByLocaleFull : pastEventsByLocalePublic;

const upcoming = await client.fetch<
  Array<{
    title: string;
    slug: string;
    startDateTime: string;
    endDateTime: string;
    timezone: string;
  }>
>(upcomingQuery, { locale, now });

const past = await client.fetch<
  Array<{
    title: string;
    slug: string;
    startDateTime: string;
    endDateTime: string;
    timezone: string;
  }>
>(pastQuery, { locale, now });

const langSwitcherAlternates = Object.fromEntries(
  publishedLocales.map((l) => [l, withLocalePath(l, "events")]),
) as LangHrefMap;
---

<BaseLayout
  title="Events"
  locale={locale}
  langSwitcherAlternates={langSwitcherAlternates}
  pathAfterLocale="events"
>
  <EventsIndex locale={locale} upcoming={upcoming} past={past} />
</BaseLayout>
