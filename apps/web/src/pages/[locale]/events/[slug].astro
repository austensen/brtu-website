---
import type { SupportedLocale } from "@brtu/locales";
import EventDetail from "../../../components/EventDetail.tsx";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import RedirectShell from "../../../components/RedirectShell.astro";
import { fetchLangHrefAlternates, englishSourceId } from "../../../lib/i18n/langAlternates";
import { publishedLocales, supportedLocales, withLocalePath } from "../../../lib/i18n/locales";
import { googleCalendarTemplateUrl } from "../../../lib/events/googleCalendar";
import { getSanityClient } from "../../../lib/sanity/client";
import { allEventPathRows, eventBySlugAndLocale } from "../../../lib/sanity/queries";
import { richTextToHtml } from "../../../lib/sanity/portableText";
import { buildTranslatableSlugPaths } from "../../../lib/i18n/staticPaths";

export async function getStaticPaths() {
  const client = getSanityClient();
  const rows = await client.fetch(allEventPathRows);
  const paths = buildTranslatableSlugPaths(
    rows,
    publishedLocales,
    "en",
    (loc, s) => withLocalePath(loc, `events/${s}`),
  );
  return paths.map((p) => ({ params: p.params, props: p.props }));
}

const locale = Astro.params.locale as SupportedLocale;
const slug = Astro.params.slug as string;

if (!supportedLocales.includes(locale) || !slug) {
  return new Response(null, { status: 404 });
}

const mode = Astro.props.mode as "content" | "redirect";
const redirectTo = Astro.props.redirectTo as string | undefined;
const showRedirect = mode === "redirect" && Boolean(redirectTo);

const client = getSanityClient();
const event = showRedirect
  ? null
  : await client.fetch<{
      _id: string;
      locale: string;
      title: string;
      slug: string;
      startDateTime: string;
      endDateTime: string;
      timezone: string;
      location?: string | null;
      mapLink?: string | null;
      joinUrl?: string | null;
      promotionalFlyer?: {
        asset?: { url: string; originalFilename?: string | null; mimeType?: string | null } | null;
      } | null;
      description: unknown;
      translationOf?: { _id: string } | null;
    }>(eventBySlugAndLocale, { locale, slug });

if (!showRedirect && !event) {
  return new Response(null, { status: 404 });
}

const bodyHtml = event ? richTextToHtml(event.description as never) : "";
const enId = event ? englishSourceId(event) : "";
const langSwitcherAlternates = event
  ? await fetchLangHrefAlternates(
      client,
      "event",
      enId,
      (loc, s) => withLocalePath(loc, `events/${s}`),
      publishedLocales,
    )
  : {};
const pathAfterLocale = event ? `events/${event.slug}` : `events/${slug}`;

const gcal = event
  ? googleCalendarTemplateUrl({
      title: event.title,
      startDateTime: event.startDateTime,
      endDateTime: event.endDateTime,
      location: event.location,
      joinUrl: event.joinUrl,
      description: event.description,
    })
  : "";

const icsHref = `/calendar/${locale}/${slug}.ics`;

const flyerAsset = event?.promotionalFlyer?.asset;
const flyerUrl = flyerAsset?.url ?? null;
const flyerMimeType = flyerAsset?.mimeType ?? null;
const flyerFilename = flyerAsset?.originalFilename ?? null;
---

{
  showRedirect ? (
    <RedirectShell to={redirectTo!} />
  ) : (
    <BaseLayout
      title={event!.title}
      locale={locale}
      langSwitcherAlternates={langSwitcherAlternates}
      pathAfterLocale={pathAfterLocale}
    >
      <EventDetail
        locale={locale}
        title={event!.title}
        startDateTime={event!.startDateTime}
        endDateTime={event!.endDateTime}
        timezone={event!.timezone}
        location={event!.location}
        mapLink={event!.mapLink}
        joinUrl={event!.joinUrl}
        flyerUrl={flyerUrl}
        flyerMimeType={flyerMimeType}
        flyerFilename={flyerFilename}
        bodyHtml={bodyHtml}
        gcal={gcal}
        icsHref={icsHref}
      />
    </BaseLayout>
  )
}
