---
import type { SupportedLocale } from "@brtu/locales";
import BlogPostArticle from "../../../components/BlogPostArticle.tsx";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import RedirectShell from "../../../components/RedirectShell.astro";
import { fetchLangHrefAlternates, englishSourceId } from "../../../lib/i18n/langAlternates";
import { publishedLocales, supportedLocales, withLocalePath } from "../../../lib/i18n/locales";
import { getSanityClient } from "../../../lib/sanity/client";
import { allPostsPathRows, postBySlugAndLocale } from "../../../lib/sanity/queries";
import { urlForSanityImage } from "../../../lib/sanity/image";
import { richTextToHtml } from "../../../lib/sanity/portableText";
import { buildTranslatableSlugPaths } from "../../../lib/i18n/staticPaths";

export async function getStaticPaths() {
  const client = getSanityClient();
  const rows = await client.fetch(allPostsPathRows);
  const paths = buildTranslatableSlugPaths(
    rows,
    publishedLocales,
    "en",
    (loc, s) => withLocalePath(loc, `blog/${s}`),
  );
  return paths.map((p) => ({ params: p.params, props: p.props }));
}

const locale = Astro.params.locale as SupportedLocale;
const slug = Astro.params.slug as string;

if (!supportedLocales.includes(locale) || !slug) {
  return new Response(null, { status: 404 });
}

const mode = Astro.props.mode as "content" | "redirect";
const redirectTo = Astro.props.redirectTo as string | undefined;
const showRedirect = mode === "redirect" && Boolean(redirectTo);

const client = getSanityClient();
const post = showRedirect
  ? null
  : await client.fetch<{
      _id: string;
      locale: string;
      title: string;
      slug: string;
      publishedAt: string;
      heroImage?: { asset?: unknown; alt?: string | null };
      body: unknown;
      translationOf?: { _id: string } | null;
    }>(postBySlugAndLocale, { locale, slug });

if (!showRedirect && !post) {
  return new Response(null, { status: 404 });
}

const bodyHtml = post ? richTextToHtml(post.body as never) : "";
const enId = post ? englishSourceId(post) : "";
const langSwitcherAlternates = post
  ? await fetchLangHrefAlternates(
      client,
      "post",
      enId,
      (loc, s) => withLocalePath(loc, `blog/${s}`),
      publishedLocales,
    )
  : {};
const pathAfterLocale = post ? `blog/${post.slug}` : `blog/${slug}`;
const heroUrl = post?.heroImage?.asset ? urlForSanityImage(post.heroImage as never)?.width(1200).url() : null;
const heroAlt = post?.heroImage?.alt?.trim() ?? "";
---

{
  showRedirect ? (
    <RedirectShell to={redirectTo!} />
  ) : (
    <BaseLayout
      title={post!.title}
      locale={locale}
      langSwitcherAlternates={langSwitcherAlternates}
      pathAfterLocale={pathAfterLocale}
    >
      <BlogPostArticle
        locale={locale}
        title={post!.title}
        publishedAt={post!.publishedAt}
        heroUrl={heroUrl}
        heroAlt={heroAlt}
        bodyHtml={bodyHtml}
      />
    </BaseLayout>
  )
}
