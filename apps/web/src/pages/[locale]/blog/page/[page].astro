---
import type { SupportedLocale } from "@brtu/locales";
import BlogPostIndex from "../../../../components/BlogPostIndex.tsx";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { POSTS_PER_PAGE } from "../../../../lib/blog/constants";
import type { LangHrefMap } from "../../../../lib/i18n/langAlternates";
import { publishedLocales, supportedLocales, withLocalePath } from "../../../../lib/i18n/locales";
import { urlForSanityImage } from "../../../../lib/sanity/image";
import { getSanityClient } from "../../../../lib/sanity/client";
import { postCountByLocale, postsByLocaleSlice } from "../../../../lib/sanity/queries";

export async function getStaticPaths() {
  const client = getSanityClient();
  const paths: Array<{ params: { locale: string; page: string } }> = [];
  for (const locale of publishedLocales) {
    const total = await client.fetch<number>(postCountByLocale, { locale });
    const totalPages = Math.max(1, Math.ceil(total / POSTS_PER_PAGE));
    for (let p = 2; p <= totalPages; p++) {
      paths.push({ params: { locale, page: String(p) } });
    }
  }
  return paths;
}

const locale = Astro.params.locale as SupportedLocale;
const pageNum = Number(Astro.params.page);

if (!supportedLocales.includes(locale) || !Number.isFinite(pageNum) || pageNum < 2) {
  return new Response(null, { status: 404 });
}

const client = getSanityClient();
const total = await client.fetch<number>(postCountByLocale, { locale });
const totalPages = Math.max(1, Math.ceil(total / POSTS_PER_PAGE));

if (pageNum > totalPages) {
  return new Response(null, { status: 404 });
}

const start = (pageNum - 1) * POSTS_PER_PAGE;
const end = start + POSTS_PER_PAGE;
const posts = await client.fetch<
  Array<{
    _id: string;
    title: string;
    slug: string;
    publishedAt: string;
    heroImage?: { asset?: unknown; alt?: string | null };
  }>
>(postsByLocaleSlice, { locale, start, end });

const langSwitcherAlternates = {} as LangHrefMap;
for (const l of publishedLocales) {
  const t = await client.fetch<number>(postCountByLocale, { locale: l });
  const tp = Math.max(1, Math.ceil(t / POSTS_PER_PAGE));
  if (pageNum <= tp) {
    langSwitcherAlternates[l] = withLocalePath(l, `blog/page/${pageNum}`);
  } else {
    langSwitcherAlternates[l] = withLocalePath("en", `blog/page/${pageNum}`);
  }
}

const postsForIndex = posts.map((post) => {
  const img = post.heroImage?.asset
    ? urlForSanityImage(post.heroImage as never)?.width(800).url()
    : null;
  return {
    title: post.title,
    slug: post.slug,
    publishedAt: post.publishedAt,
    heroImageUrl: img ?? null,
    heroAlt: post.heroImage?.alt?.trim() || "",
  };
});
---

<BaseLayout
  title={`Blog — page ${pageNum}`}
  locale={locale}
  langSwitcherAlternates={langSwitcherAlternates}
  pathAfterLocale={`blog/page/${pageNum}`}
>
  <BlogPostIndex locale={locale} posts={postsForIndex} pageNum={pageNum} totalPages={totalPages} />
</BaseLayout>
