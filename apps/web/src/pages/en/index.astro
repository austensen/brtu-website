---
import BaseLayout from "../../layouts/BaseLayout.astro";

const locale = "en" as const;
const title = "Bay Ridge Tenant Union";
---

<BaseLayout title={title} locale={locale}>
  <script is:inline slot="head">
    (() => {
      try {
        const key = "brtu_locale_redirected_v1";
        if (sessionStorage.getItem(key)) return;
        sessionStorage.setItem(key, "1");
        // WS-B: detect once per session on first hit; full locale routing ties to CMS (WS-F+).
      } catch {}
    })();
  </script>

  <h1>{title}</h1>
  <p>Locale-prefixed routing is live. Marketing pages and Sanity content will land in the next workstreams.</p>
  <div class="card" style="margin-top: var(--space-6); max-width: 40rem;">
    <p style="margin:0;">
      Example card surface for resources and events. Rich text will use the <code>.prose</code> wrapper when blog
      and pages ship.
    </p>
  </div>
</BaseLayout>
