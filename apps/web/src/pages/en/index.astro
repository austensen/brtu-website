---
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";

const title = "BRTU";
const locale = "en" as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const key = "brtu_locale_redirected_v1";
          if (sessionStorage.getItem(key)) return;
          sessionStorage.setItem(key, "1");
          // WS-B locked: detect once per session on first hit.
          // WS-B locked: if locale unavailable, default to English.
          // NOTE: until Sanity is wired, only English is considered published.
        } catch {}
      })();
    </script>
  </head>
  <body>
    <main style="font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; padding: 2rem;">
      <LanguageSwitcher currentLocale={locale} />
      <h1>{title}</h1>
      <p>WS-B routing skeleton is live under locale-prefixed routes.</p>
    </main>
  </body>
</html>

