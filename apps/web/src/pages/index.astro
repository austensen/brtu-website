---
// Canonical routes are locale-prefixed (e.g. /en/...)
// This top-level page exists only to support static hosting fallback.
import "../styles/global.css";

const title = "BRTU";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta http-equiv="refresh" content="0; url=/en/" />
  </head>
  <body>
    <main class="standalone-main">
      <h1>{title}</h1>
      <p>Redirecting to English…</p>
    </main>
  </body>
</html>

