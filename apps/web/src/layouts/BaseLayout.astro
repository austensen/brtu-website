---
/**
 * A11y baseline: skip link, single main landmark, lang + dir, focus-visible in global.css,
 * reduced-motion in global.css. Keep heading order sane in page templates (one h1 per page).
 */
import { isRtlLocale, type SupportedLocale } from "@brtu/locales";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import type { LangHrefMap } from "../lib/i18n/langAlternates";
import { getSanityClient } from "../lib/sanity/client";
import { marketingNavSlugsByLocale } from "../lib/sanity/queries";
import "../styles/global.css";

type Props = {
  title: string;
  locale: SupportedLocale;
  description?: string;
  langSwitcherAlternates?: LangHrefMap;
  pathAfterLocale?: string;
};

const { title, locale, description, langSwitcherAlternates, pathAfterLocale } = Astro.props;
const dir = isRtlLocale(locale) ? "rtl" : "ltr";
const orgName = "Bay Ridge Tenant Union";

const client = getSanityClient();
const navRows = await client.fetch<Array<{ pageType: string; slug: string }>>(
  marketingNavSlugsByLocale,
  { locale },
);
const aboutSlug = navRows.find((r) => r.pageType === "about")?.slug ?? "about";
const contactSlug = navRows.find((r) => r.pageType === "contact")?.slug ?? "contact";
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    <slot name="head" />
  </head>
  <body class="layout-shell">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header
      locale={locale}
      organizationName={orgName}
      aboutSlug={aboutSlug}
      contactSlug={contactSlug}
      langSwitcherAlternates={langSwitcherAlternates}
      pathAfterLocale={pathAfterLocale}
    />
    <main id="main-content" class="layout-main" tabindex="-1">
      <slot />
    </main>
    <Footer organizationName={orgName} locale={locale} aboutSlug={aboutSlug} contactSlug={contactSlug} />
  </body>
</html>
