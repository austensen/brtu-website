---
import { publishedLocales, type SupportedLocale } from "../lib/i18n/locales";

type Props = {
  currentLocale: SupportedLocale;
  pathAfterLocale?: string;
};

const { currentLocale, pathAfterLocale = "" } = Astro.props;
const targetPath = (locale: SupportedLocale) => `/${locale}/${pathAfterLocale}`.replace(/\/+$/, "/");
---

<ul class="lang-switcher" aria-label="Language">
  {
    publishedLocales.map((locale) => (
      <li>
        <a
          href={targetPath(locale)}
          aria-current={locale === currentLocale ? "page" : undefined}
        >
          {locale.toUpperCase()}
        </a>
      </li>
    ))
  }
</ul>
