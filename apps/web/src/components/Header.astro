---
import type { SupportedLocale } from "@brtu/locales";
import { withLocalePath } from "../lib/i18n/locales";
import type { LangHrefMap } from "../lib/i18n/langAlternates";
import LanguageSwitcher from "./LanguageSwitcher.astro";

type Props = {
  locale: SupportedLocale;
  organizationName: string;
  aboutSlug: string;
  contactSlug: string;
  langSwitcherAlternates?: LangHrefMap;
  pathAfterLocale?: string;
};

const { locale, organizationName, aboutSlug, contactSlug, langSwitcherAlternates, pathAfterLocale } =
  Astro.props;
const homeHref = withLocalePath(locale, "");
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="site-brand" href={homeHref}>
      <img
        class="site-brand__logo"
        src="/images/brtu-logo.png"
        width="52"
        height="52"
        alt=""
        decoding="async"
        fetchpriority="high"
      />
      <span>{organizationName}</span>
    </a>
    <button
      type="button"
      class="site-nav__toggle"
      aria-controls="site-nav"
      aria-expanded="false"
      data-site-nav-toggle
      hidden
    >
      <span class="site-nav__toggle-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Primary" data-site-nav>
      <ul class="site-nav__primary">
        <li>
          <a href={homeHref}>Home</a>
        </li>
        <li>
          <a href={withLocalePath(locale, aboutSlug)}>About</a>
        </li>
        <li>
          <a href={withLocalePath(locale, contactSlug)}>Contact</a>
        </li>
        <li>
          <a href={withLocalePath(locale, "blog")}>Blog</a>
        </li>
        <li>
          <a href={withLocalePath(locale, "resources")}>Resources</a>
        </li>
        <li>
          <a href={withLocalePath(locale, "events")}>Events</a>
        </li>
      </ul>
      <LanguageSwitcher
        currentLocale={locale}
        pathAfterLocale={pathAfterLocale}
        alternates={langSwitcherAlternates}
      />
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector("[data-site-header]");
    if (!header) return;
    var toggle = header.querySelector("[data-site-nav-toggle]");
    var nav = header.querySelector("[data-site-nav]");
    if (!toggle || !nav) return;

    var mobileMq = window.matchMedia("(max-width: 47.9375rem)");
    var open = false;

    function setOpen(next) {
      open = next;
      toggle.setAttribute("aria-expanded", next ? "true" : "false");
      if (next) {
        header.setAttribute("data-menu-open", "");
      } else {
        header.removeAttribute("data-menu-open");
      }
    }

    function applyMode() {
      if (mobileMq.matches) {
        header.setAttribute("data-menu-enhanced", "");
        toggle.hidden = false;
      } else {
        header.removeAttribute("data-menu-enhanced");
        toggle.hidden = true;
        setOpen(false);
      }
    }

    toggle.addEventListener("click", function () {
      setOpen(!open);
    });

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && open) {
        setOpen(false);
        toggle.focus();
      }
    });

    nav.addEventListener("click", function (event) {
      var target = event.target;
      if (target && target.closest && target.closest("a") && open) {
        setOpen(false);
      }
    });

    if (typeof mobileMq.addEventListener === "function") {
      mobileMq.addEventListener("change", applyMode);
    } else if (typeof mobileMq.addListener === "function") {
      mobileMq.addListener(applyMode);
    }

    applyMode();
  })();
</script>
